# Copia este archivo a .env.local para desarrollo o configura estas variables en Vercel.
# NUNCA subas .env ni .env.local al repositorio.

# URL pública del sitio. En Vercel Production es obligatoria.
# En Preview, si no se define, se usa VERCEL_URL como respaldo.
SITE_URL=http://localhost:3000

# integration | production
TBK_ENV=integration

# Credenciales de Transbank. En integration pueden quedar vacías: se usan
# las credenciales públicas de prueba incluidas en el SDK.
# En production son OBLIGATORIAS y deben existir solo en Vercel.
TBK_COMMERCE_CODE=
TBK_API_KEY=

# Secreto para firmar el token de resultado (mínimo 32 caracteres aleatorios).
# Solo debe existir como variable de entorno.
PAYMENT_RESULT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
