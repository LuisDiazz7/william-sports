# Copia este archivo a server/.env y completa los valores.
# NUNCA subas .env al repositorio.

# --- Servidor ---
PORT=3000
# URL pública de este servidor (donde corre la API). Se usa para la returnUrl de Webpay.
APP_BASE_URL=http://localhost:3000
# URL del sitio frontend (para el redirect al comprobante). Si el servidor sirve el
# sitio estático, puede ser la misma que APP_BASE_URL.
FRONTEND_URL=http://localhost:3000
# Ruta de la base SQLite (opcional; por defecto server/data/william.db)
# DB_PATH=

# --- Webpay Plus (Transbank) ---
# integration | production
TBK_ENV=integration
# En integration pueden quedar vacíos: se usan las credenciales públicas de prueba.
# En production son OBLIGATORIOS.
TBK_COMMERCE_CODE=
TBK_API_KEY=

# --- Correo (comprobante) ---
# Si SMTP_HOST queda vacío, el comprobante solo se entrega vía API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="William Sport <no-reply@williamssport.cl>"
